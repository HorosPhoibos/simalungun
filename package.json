{
  "name": "pustaha-simalungun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:corpus": "node scripts/build-bible-corpus.mjs",
    "build:cf": "vite build --outDir dist-cf && node scripts/copy-private-data.mjs",
    "preview:cf": "wrangler pages dev dist-cf",
    "deploy:cf": "npm run build:cf && wrangler pages deploy dist-cf --project-name pustaha-simalungun --branch main",
